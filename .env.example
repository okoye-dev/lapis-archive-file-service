PORT=6060
READ_TIMEOUT=30
WRITE_TIMEOUT=30
IDLE_TIMEOUT=120
SHUTDOWN_TIMEOUT=5

LOG_LEVEL=info
GIN_MODE=release

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_USE_SSL=true
S3_BUCKET_NAME=your-bucket-name
S3_FORCE_PATH_STYLE=false

MAX_UPLOAD_MB=512
ALLOWED_ORIGINS=*
# Comma-separated proxy CIDRs to trust for the real client IP (rate limiting).
# Leave empty to trust none; behind a known proxy (e.g. Railway) set its CIDR.
TRUSTED_PROXIES=

# Database + auth (share history + owner-scoped endpoints). Anonymous
# quick-shares work without either; share endpoints return 503 without a DB.
# With Supabase (<ref> = your project's subdomain):
#   DATABASE_URL:   postgresql://postgres.<ref>:<PW>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   AUTH_JWKS_URL:  https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#   AUTH_ISSUER:    https://<ref>.supabase.co/auth/v1
#   AUTH_AUDIENCE:  authenticated
# The issuer must sign with asymmetric keys (ES256/RS256); a JWKS with no keys
# is rejected at startup.
DATABASE_URL=
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
