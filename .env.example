# Remote S3-compatible storage (AWS S3, Cloudflare R2, Supabase Storage)
# Copy to .env and fill in real credentials. Never commit .env files.

PORT=6060
READ_TIMEOUT=30
WRITE_TIMEOUT=30
IDLE_TIMEOUT=120
SHUTDOWN_TIMEOUT=5

LOG_LEVEL=info
GIN_MODE=release

# Leave S3_ENDPOINT empty for AWS S3; set host (no scheme) for R2/Supabase/MinIO
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_USE_SSL=true
S3_BUCKET_NAME=your-bucket-name
S3_FORCE_PATH_STYLE=false
