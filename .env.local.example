# Local development against MinIO (make dev starts it)
# Copy to .env.local — these defaults work out of the box.

PORT=6060
READ_TIMEOUT=30
WRITE_TIMEOUT=30
IDLE_TIMEOUT=120
SHUTDOWN_TIMEOUT=5

LOG_LEVEL=debug
GIN_MODE=debug

S3_ENDPOINT=localhost:47470
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
S3_BUCKET_NAME=oss-archive
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_MB=512
ALLOWED_ORIGINS=*

# Database + auth are optional locally: anonymous shares work without them.
# DATABASE_URL points at the Postgres started by docker-compose.dev.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:47432/lapis?sslmode=disable
AUTH_JWKS_URL=
AUTH_ISSUER=
